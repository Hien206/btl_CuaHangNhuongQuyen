      "name": "1. Authentication & NguoiDung",
      "item": [
        {
          "name": "POST Register Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hien@gmail.com\",\n  \"matkhau\": \"123456\",\n  \"hoten\": \"Nguyễn Minh Hiển\",\n  \"vaitroid\": 1\n}"
            },
            "url": {
              "raw": "https://localhost:44390/api/NguoiDung/register",
              "protocol": "https",
              "host": [
                "localhost"
              ],
              "port": "44390",
              "path": [
                "api",
                "NguoiDung",
                "register"
              ]
            }
          }
        },
        {
          "name": "POST Login Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hien@gmail.com\",\n  \"matkhau\": \"123456\"\n}"
            },
            "url": {
              "raw": "https://localhost:44390/api/NguoiDung/login",
              "protocol": "https",
              "host": [
                "localhost"
              ],
              "port": "44390",
              "path": [
                "api",
                "NguoiDung",
                "login"
              ]
            }
          }
        }
      ]
    },
